# Database URL. Defaults to a local SQLite file; switch to Postgres by changing
# this one variable, e.g. postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:///./form2email.db

# Resend API key (https://resend.com). Required for real email delivery.
RESEND_API_KEY=

# Sender address. Resend's onboarding@resend.dev works before domain
# verification but only delivers to your own Resend account email.
MAIL_FROM=onboarding@resend.dev

# Public base URL used in verification links and form action URLs.
BASE_URL=http://localhost:8000

# Days an endpoint stays active after email verification (free tier).
DEFAULT_TTL_DAYS=7

# Hours a verification link stays valid.
VERIFICATION_TOKEN_TTL_HOURS=24

# Rate limits (per client IP, in-memory). Once the submit cap is exceeded,
# each further attempt doubles the lockout from base to max seconds.
RATE_LIMIT_CREATE_PER_HOUR=5
RATE_LIMIT_SUBMIT_PER_MINUTE=30
RATE_LIMIT_SUBMIT_BACKOFF_BASE_SECONDS=1
RATE_LIMIT_SUBMIT_BACKOFF_MAX_SECONDS=300

# Verification emails sent to any single destination address per day, across
# all client IPs — stops endpoint creation being used to flood a mailbox.
RATE_LIMIT_VERIFICATION_PER_EMAIL_PER_DAY=3

# Discovery/docs routes (/api/info, /llms.txt, /for-coding-tools) share one
# per-IP bucket.
RATE_LIMIT_META_PER_MINUTE=3

# Submissions with a larger Content-Length are rejected with 413.
MAX_SUBMISSION_BODY_BYTES=65536

# Shared secret the Cloudflare Worker sends on every request. Direct origin
# access without it is rejected. Leave empty in local dev; set a long random
# value in production (openssl rand -hex 32).
ORIGIN_TOKEN=

# Token protecting the admin API (X-Admin-Token header) used to grant or
# revoke endpoint permanence. When empty the admin routes are disabled.
# Set a long random value in production (openssl rand -hex 32).
ADMIN_TOKEN=

# Mail transport: "resend" (HTTP API, default) or "smtp" (std lib, any
# provider — or a local Postfix/relay on localhost).
MAIL_DRIVER=resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
